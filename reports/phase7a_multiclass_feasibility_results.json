  "recommendations": {
    "recommended_option": "Option A (Hierarchical Two-Stage Architecture)",
    "justification": [
      "Preserves the existing Phase 1-6 verified binary Random Forest model, its weights, its canonical SHA-256 hash, and its smart contract registration completely unchanged.",
      "Normal traffic (which constitutes the vast majority of benign flows in IoT networks) is processed solely by the lightweight binary model without incurring multi-class overhead.",
      "Maintains high binary detection performance (90.30% accuracy, 98.78% precision, 2.29% FPR) as an independent security gate before fine-grained diagnostic classification.",
      "Isolates the multi-class training distribution strictly to attack flows (N=45,332 train, N=119,341 test), focusing classification capacity on discriminating between the 9 distinct attack types."
    ],
    "option_b_drawbacks": [
      "Option B (Single flat 10-class model including Normal) would require retraining and replacing the existing baseline, destroying historical comparability and requiring re-registration on-chain.",
      "Flat 10-class models conflate benign false positives with inter-attack misclassifications, weakening the binary defense perimeter."
    ],
    "response_recommendation_scope": {
      "distinction": "Statistical flow classification ('This flow resembles DoS') vs. Operational remediation advice ('Rate limit source IP')",
      "dataset_limitations": "UNSW-NB15 contains passive network packet telemetry; it does NOT contain ground-truth remediation actions, operational mitigation histories, or causal counterfactuals.",
      "research_boundary": "Response recommendations must be explicitly structured as heuristic advisory guidance for security analysts, NOT as verified causal proofs that an attack will be automatically neutralized."
    },
